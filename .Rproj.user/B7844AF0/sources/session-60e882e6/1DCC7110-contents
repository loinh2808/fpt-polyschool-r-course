format:
  html:
    theme:
      light: flatly
      dark: darkly
    mermaid:
      theme: forest
    css: styles.css
    toc: true
    toc-depth: 3
    toc-location: right
    number-sections: false
    page-layout: article
    smooth-scroll: true
    code-copy: true
    code-overflow: wrap
    code-tools: true
    code-fold: false
    df-print: paged
    fontsize: 1rem
    linestretch: 1.6
    highlight-style: github

execute:
  freeze: auto
  warning: false
  message: false

editor: visual
