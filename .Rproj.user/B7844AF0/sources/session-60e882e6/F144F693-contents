# Step 4: Build PLS-SEM Model

```{r}
library(seminr)

measurement_model <- constructs(
composite("PE", multi_items("PE",1:4)),
composite("EE", multi_items("EE",1:4)),
composite("SI", multi_items("SI",1:3)),
composite("FC", multi_items("FC",1:3)),
composite("HM", multi_items("HM",1:3)),
composite("PV", multi_items("PV",1:3)),
composite("HT", multi_items("HT",1:4)),
composite("PI", multi_items("PI",1:4)),
composite("BI", multi_items("BI",1:3)),
composite("UB", single_item("UB1"))
)

structural_model <- relationships(
paths(from = c("PE","EE","SI","FC","HM","PV","HT","PI"), to = "BI"),
paths(from = c("FC","HT","BI"), to = "UB")
)

pls_model <- estimate_pls(
data = utaut_data,
measurement_model,
structural_model
)
```

# Step 5: Bootstrap

```{r}
boot_model <- bootstrap_model(
pls_model,
nboot = 5000
)

summary(boot_model)
```

